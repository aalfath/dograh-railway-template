# Rendered by the nginx image's envsubst step at start-up.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Railway terminates TLS at its edge and sends X-Forwarded-Proto.
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    # Re-resolve private hostnames, so redeployed services are found again.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;

    set $dograh_api ${DOGRAH_API_HOST}:8000;
    set $dograh_ui  ${DOGRAH_UI_HOST}:3010;
    set $minio      ${MINIO_HOST}:9000;

    client_max_body_size 100M;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Backend API and WebSockets (signalling, telephony media streams).
    location /api/v1/ {
        proxy_pass http://$dograh_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Private bucket on MinIO. Only presigned (signed, expiring) URLs work; the Host
    # header is passed unchanged because it is part of the signature.
    location /voice-audio/ {
        proxy_pass http://$minio;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Everything else: the Next.js UI.
    location / {
        proxy_pass http://$dograh_ui;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }
}
